{
  "openapi": "3.1.0",
  "info": {
    "title": "LinkRight HQ — Command Center",
    "version": "1.0.0",
    "description": "Satvik's personal command center. Control SMA, query data, manage content — all via conversation."
  },
  "servers": [
    {
      "url": "https://n8n.linkright.in"
    }
  ],
  "paths": {
    "/webhook/sma-submit-brief": {
      "post": {
        "operationId": "submitBrief",
        "summary": "Submit a new content topic brief to Google Sheet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["topic"],
                "properties": {
                  "topic": { "type": "string", "description": "Content topic title" },
                  "research_data": { "type": "string", "description": "Stats, data points, research supporting this topic" },
                  "why_relevant": { "type": "string", "description": "Why this topic is relevant for Satvik's LinkedIn audience" },
                  "target_audience": { "type": "string", "description": "Who this content targets" },
                  "reference_links": { "type": "string", "description": "Comma-separated reference URLs" },
                  "has_stats": { "type": "string", "enum": ["TRUE", "FALSE"], "description": "Has statistical data" },
                  "has_quotes": { "type": "string", "enum": ["TRUE", "FALSE"], "description": "Has expert quotes" },
                  "has_trend": { "type": "string", "enum": ["TRUE", "FALSE"], "description": "Has trending angle" },
                  "has_data": { "type": "string", "enum": ["TRUE", "FALSE"], "description": "Has supporting data" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Brief submitted successfully" }
        }
      }
    },
    "/webhook/sma-fetch-briefs": {
      "post": {
        "operationId": "fetchBriefs",
        "summary": "Fetch content briefs from Google Sheet filtered by status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "description": "Filter by status: New, Planned, Used, Discarded", "default": "New" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "List of briefs matching the status filter" }
        }
      }
    },
    "/webhook/sma-fetch-past-posts": {
      "post": {
        "operationId": "fetchPastPosts",
        "summary": "Fetch recent LinkedIn posts from MongoDB",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "days": { "type": "integer", "description": "Lookback period in days", "default": 14 },
                  "channel": { "type": "string", "description": "Content channel", "default": "linkedin" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "List of recent posts with metrics" }
        }
      }
    },
    "/webhook/sma-search-experiences": {
      "post": {
        "operationId": "searchExperiences",
        "summary": "Semantic search through Satvik's life experiences using vector search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["queries"],
                "properties": {
                  "queries": { "type": "array", "items": { "type": "string" }, "description": "Search queries for finding relevant experiences" },
                  "limit": { "type": "integer", "description": "Max results per query", "default": 3 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Matched experiences grouped by query with similarity scores" }
        }
      }
    },
    "/webhook/sma-fetch-config": {
      "post": {
        "operationId": "fetchConfig",
        "summary": "Fetch scoring configuration (weights, scales, schedule)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "doc_ids": { "type": "array", "items": { "type": "string" }, "description": "Config document IDs to fetch: scoring_weights, scoring_scales, posting_schedule. Empty = fetch all." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Config documents keyed by _id" }
        }
      }
    },
    "/webhook/sma-update-sheet-status": {
      "post": {
        "operationId": "updateSheetStatus",
        "summary": "Update brief status, scores, and reason in Google Sheet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["updates"],
                "properties": {
                  "updates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "row_id": { "type": "string", "description": "Row ID to update" },
                        "status": { "type": "string", "enum": ["New", "Planned", "Used", "Discarded"], "description": "New status" },
                        "scores": { "type": "string", "description": "Score breakdown e.g. F:8 P:7 R:6 T:131" },
                        "reason": { "type": "string", "description": "Reason for status change" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Update confirmation with count" }
        }
      }
    },
    "/webhook/sma-save-config": {
      "post": {
        "operationId": "saveConfig",
        "summary": "Update scoring configuration in MongoDB",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["configs"],
                "properties": {
                  "configs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "_id": { "type": "string", "description": "Config doc ID: scoring_weights, scoring_scales, or posting_schedule" },
                        "weights": { "type": "object", "description": "Scoring weights (freshness, personal_experience, research_quality)" },
                        "top_n": { "type": "integer", "description": "Number of top posts to select" },
                        "lookback_days": { "type": "integer", "description": "Days to look back for freshness check" },
                        "updated_by": { "type": "string", "description": "Who made the change" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Save confirmation" }
        }
      }
    },
    "/webhook/sma-save-experience": {
      "post": {
        "operationId": "saveExperience",
        "summary": "Save a new life experience with vector embedding for future content matching",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["experiences"],
                "properties": {
                  "experiences": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["text"],
                      "properties": {
                        "text": { "type": "string", "description": "Experience description in English for best embedding accuracy" },
                        "date": { "type": "string", "description": "Date of experience (YYYY-MM-DD)" },
                        "tags": { "type": "string", "description": "Comma-separated tags" },
                        "category": { "type": "string", "description": "Category: career, academic, mentorship, startup, personal" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Insert confirmation with count" }
        }
      }
    },
    "/webhook/sma-save-post": {
      "post": {
        "operationId": "savePost",
        "summary": "Save a drafted LinkedIn post to MongoDB",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["post"],
                "properties": {
                  "post": {
                    "type": "object",
                    "required": ["title", "content"],
                    "properties": {
                      "title": { "type": "string" },
                      "content": { "type": "string", "description": "Full post content" },
                      "content_pillar": { "type": "string" },
                      "scheduled_date": { "type": "string", "description": "YYYY-MM-DD" },
                      "scheduled_time": { "type": "string", "default": "09:00" },
                      "status": { "type": "string", "enum": ["Draft", "Ready", "Published"], "default": "Draft" },
                      "scores": { "type": "object", "description": "Scoring breakdown" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Post saved with MongoDB _id" }
        }
      }
    },
    "/webhook/sma-fetch-post": {
      "post": {
        "operationId": "fetchPost",
        "summary": "Fetch posts by ID or by filters (status, channel, limit, date range)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "post_id": { "type": "string", "description": "Specific post ID to fetch" },
                  "status": { "type": "string", "description": "Filter by status: Draft, Drafted, Formatting, Previewed, Ready_ToPublish, Published" },
                  "channel": { "type": "string", "description": "Content channel", "default": "linkedin" },
                  "limit": { "type": "integer", "description": "Max number of posts to return" },
                  "days": { "type": "integer", "description": "Lookback period in days" },
                  "scheduled_date": { "type": "string", "description": "Filter by scheduled date (YYYY-MM-DD)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Single post object if post_id provided, otherwise { posts: [], count: N }" }
        }
      }
    },
    "/webhook/sma-update-post": {
      "post": {
        "operationId": "updatePost",
        "summary": "Update a post by ID. Merges updates into existing document.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["post_id", "updates"],
                "properties": {
                  "post_id": { "type": "string", "description": "Post ID to update" },
                  "updates": { "type": "object", "description": "Fields to merge into existing post document" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Update confirmation with success, post_id, and updated_fields" }
        }
      }
    },
    "/webhook/sma-publish-linkedin": {
      "post": {
        "operationId": "publishLinkedIn",
        "summary": "Publish a post to LinkedIn. ONE SHOT — no retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["post_id", "content"],
                "properties": {
                  "post_id": { "type": "string", "description": "Post ID being published" },
                  "content": { "type": "string", "description": "Full post content to publish" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success with linkedin_post_urn and linkedin_post_url, or failure with error" }
        }
      }
    },
    "/webhook/sma-notify-telegram": {
      "post": {
        "operationId": "notifyTelegram",
        "summary": "Send notification to SMA Control Group on Telegram",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "description": "Notification message to send" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success with message_id" }
        }
      }
    },
    "/webhook/sma-analytics-collect": {
      "post": {
        "operationId": "collectAnalytics",
        "summary": "Submit metrics from JS snippet or screenshot OCR. Appends to metrics_history.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["posts"],
                "properties": {
                  "posts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["post_url"],
                      "properties": {
                        "post_url": { "type": "string", "description": "LinkedIn post URL" },
                        "likes": { "type": "integer", "description": "Like count" },
                        "comments": { "type": "integer", "description": "Comment count" },
                        "shares": { "type": "integer", "description": "Share/repost count" },
                        "impressions": { "type": "integer", "description": "Impression count" },
                        "follower_count": { "type": "integer", "description": "Follower count at time of collection" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success with processed and skipped counts" }
        }
      }
    }
  }
}
